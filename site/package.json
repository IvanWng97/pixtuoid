{
  "name": "pixtuoid-site",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=12.0.0 <13"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test:unit": "node --test \"config/**/*.test.mjs\"",
    "check:docs": "node config/assert-docs-rendered.mjs dist",
    "audit": "npm audit --audit-level=low",
    "verify": "npm run format:check && npm run lint && npm run check && npm run knip && npm run test:unit && npm run build && npm run check:docs && npm run audit",
    "lighthouse": "lhci autorun",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/monaspace-neon": "^5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "astro": "^7.1.6",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.0.1",
    "globals": "^17.9.0",
    "knip": "^6.31.0",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prismjs": "1.30.0",
    "rehype-mermaid": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "web-vitals": "6.0.1"
  },
  "overrides": {
    "chrome-launcher@^0.13.4": "0.15.2",
    "esbuild": "0.28.1",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  }
}
