---
import { REPO, asset } from '../consts';
import { getStars, formatStars } from '../lib/github';

// Baked in at build (CSP blocks a client fetch); hides if the API is unreachable.
const stars = await getStars();
---

<section id="lobby" class="hero" data-floor="6">
  <canvas id="dust" class="dust" aria-hidden="true"></canvas>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">6F · penthouse — terminal-native, open source</p>
      <h1>
        Your coding agents,<br /> alive in a <span class="hl">pixel office</span><span
          class="cursor"
          aria-hidden="true"></span>
      </h1>
      <p class="lead">
        Every running agent session — Claude Code, Codex, and more — becomes a little animated
        coworker: typing, pacing the corridor, fetching coffee, in an ASCII office that lives in
        your terminal.
      </p>
      <div class="hero__cta">
        <a class="btn btn-primary" href="#install"
          >Install pixtuoid <span aria-hidden="true">→</span></a
        >
        <a class="btn btn-ghost" href={REPO} target="_blank" rel="noreferrer"
          >★ Star on GitHub{
            stars != null && <span class="hero__stars"> · {formatStars(stars)}</span>
          }</a
        >
      </div>
      <p class="hero__avail">macOS · Linux · Windows · crates.io · MIT licensed</p>
    </div>

    <div class="hero__demo">
      <figure class="terminal crt crt-manual">
        <div class="terminal__bar">
          <span class="terminal__dot terminal__dot--r"></span>
          <span class="terminal__dot terminal__dot--y"></span>
          <span class="terminal__dot terminal__dot--g"></span>
          <span class="terminal__title"
            >~ <span id="hero-cmd"></span><span class="cursor" aria-hidden="true"></span></span
          >
        </div>
        <video
          class="terminal__screen px"
          width="1664"
          height="1408"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={asset('demos/hero-poster.png')}
        >
          <source src={asset('demos/hero.mp4')} type="video/mp4" />
          <img
            class="px"
            width="1664"
            height="1408"
            src={asset('demos/hero-poster.png')}
            alt="A pixel-art office with animated coding-agent characters working at their desks"
          />
        </video>
        {
          /* The office reconstructs from its own pixels on load, then fades to the
            live clip beneath — the signature. Sampled from the real poster. */
        }
        <canvas id="assemble" class="assemble px" aria-hidden="true"></canvas>
        <span class="terminal__scan" aria-hidden="true"></span>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 5vw, 4.5rem) clamp(3rem, 7vw, 6rem);
  }
  .dust {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 920px) {
    .hero__grid {
      grid-template-columns: 0.92fr 1.08fr;
    }
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }
  .hero__avail {
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
  }
  /* live-at-build star count riding the Star CTA */
  .hero__stars {
    color: var(--accent-2);
    font-variant-numeric: tabular-nums;
  }
  .terminal__screen {
    width: 100%;
    height: auto;
  }
  /* particle-assembly overlay — positioned exactly over the video in JS */
  .assemble {
    position: absolute;
    top: 38px;
    left: 0;
    z-index: 2;
    pointer-events: none;
    image-rendering: pixelated;
  }
  /* the office lighting follows the visitor's wall clock (data-clock-night is set
     pre-paint in Base.astro). After hours the office dims to a cool night shift —
     applied to both the live screen and the assembly canvas so the look is
     consistent through the reveal. */
  .terminal__screen,
  .assemble {
    transition: filter 0.7s ease;
  }
  :global([data-clock-night='1']) .hero .terminal__screen,
  :global([data-clock-night='1']) .hero .assemble {
    filter: brightness(0.66) saturate(0.82) contrast(1.06) hue-rotate(-12deg);
  }
  /* a faint moonlight wash over the window, gated on the same clock flag */
  :global([data-clock-night='1']) .hero .terminal::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    border-radius: inherit;
    background: radial-gradient(130% 90% at 72% -10%, rgba(122, 152, 220, 0.16), transparent 58%);
    mix-blend-mode: screen;
  }

  /* one orchestrated page-load entrance, staggered */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .hero__copy > * {
    animation: rise 0.7s both;
  }
  .hero__copy .eyebrow {
    animation-delay: 0.05s;
  }
  .hero__copy h1 {
    animation-delay: 0.14s;
  }
  .hero__copy .lead {
    animation-delay: 0.26s;
  }
  .hero__copy .hero__cta {
    animation-delay: 0.38s;
  }
  .hero__copy .hero__avail {
    animation-delay: 0.48s;
  }
  .hero__demo {
    animation: rise 0.9s 0.3s both;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__copy > *,
    .hero__demo {
      animation: none;
    }
  }
</style>

<script is:inline>
  // Pixel-dust: warm motes drifting up through the hero (echoes the office's dust).
  (function () {
    const c = document.getElementById('dust');
    if (!c) return;
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const ctx = c.getContext('2d');
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let W = 0,
      H = 0,
      motes = [];
    const COLORS = ['#d97757', '#e6a356', '#c9b08a', '#f0e4cf'];
    function spawn(anywhere) {
      return {
        x: Math.random() * W,
        y: anywhere ? Math.random() * H : H + 4,
        s: 2 + Math.floor(Math.random() * 2),
        vy: -(0.12 + Math.random() * 0.3),
        vx: (Math.random() - 0.5) * 0.2,
        a: 0.15 + Math.random() * 0.5,
        tw: Math.random() * 6.28,
        tws: 0.01 + Math.random() * 0.03,
        col: COLORS[Math.floor(Math.random() * COLORS.length)],
      };
    }
    function resize() {
      const r = c.getBoundingClientRect();
      W = r.width;
      H = r.height;
      c.width = Math.round(W * dpr);
      c.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.max(18, Math.round((W * H) / 13000));
      motes = [];
      for (let i = 0; i < n; i++) motes.push(spawn(true));
    }
    let raf = 0,
      on = false,
      visible = false;
    function frame() {
      ctx.clearRect(0, 0, W, H);
      for (let i = 0; i < motes.length; i++) {
        const m = motes[i];
        m.x += m.vx;
        m.y += m.vy;
        m.tw += m.tws;
        if (m.y < -4) {
          motes[i] = spawn(false);
          continue;
        }
        ctx.globalAlpha = m.a * (0.55 + 0.45 * Math.sin(m.tw));
        ctx.fillStyle = m.col;
        ctx.fillRect(Math.round(m.x), Math.round(m.y), m.s, m.s);
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(frame);
    }
    function start() {
      if (on || mq.matches || !visible) return;
      on = true;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      on = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }
    resize();
    let rraf = 0;
    window.addEventListener('resize', function () {
      if (rraf) return; // coalesce a burst of resize events into one rAF
      rraf = requestAnimationFrame(function () {
        rraf = 0;
        resize();
      });
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        function (es) {
          es.forEach(function (e) {
            visible = e.isIntersecting;
            if (visible) start();
            else stop();
          });
        },
        { threshold: 0 }
      ).observe(c);
    } else {
      visible = true;
      start();
    }
    // CSS @media can't gate a canvas rAF — respond to OS reduce-motion live
    if (mq.addEventListener)
      mq.addEventListener('change', function () {
        if (mq.matches) stop();
        else start();
      });
  })();
</script>

<script is:inline>
  // Hero: once the boot intro reveals, type the command, then power on the CRT.
  (function () {
    function run() {
      const el = document.getElementById('hero-cmd');
      const term = document.querySelector('.hero .terminal');
      const text = 'pixtuoid run';
      function powerOn() {
        if (term) term.classList.add('crt-on');
      }
      if (!el) {
        powerOn();
        return;
      }
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        el.textContent = text;
        powerOn();
        return;
      }
      let i = 0;
      (function type() {
        el.textContent = text.slice(0, i);
        if (i < text.length) {
          i++;
          setTimeout(type, 55);
        } else {
          powerOn();
        }
      })();
    }
    document.addEventListener('pix:revealed', run, { once: true });
  })();
</script>

<script is:inline>
  // Native <video autoplay loop> can't be gated by CSS @media, so honor
  // prefers-reduced-motion (WCAG 2.2.2) in JS: pause + hold the poster frame,
  // and respond live to OS changes.
  (function () {
    const v = document.querySelector('.hero video');
    if (!v) return;
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    function apply() {
      if (mq.matches) {
        v.removeAttribute('autoplay');
        v.pause();
      } else if (v.paused) {
        const p = v.play();
        if (p && p.catch) p.catch(function () {});
      }
    }
    apply();
    if (mq.addEventListener) mq.addEventListener('change', apply);
  })();
</script>

<script is:inline>
  // SIGNATURE: the office reconstructs from its own pixels. Sample the real
  // poster on a coarse grid → each cell is a chunky pixel that starts scattered
  // across the frame and flies to its place, then the canvas fades to reveal the
  // live clip beneath. prefers-reduced-motion / already-seen → skip, show clip.
  (function () {
    const canvas = document.getElementById('assemble');
    const fig = document.querySelector('.hero .terminal');
    const video = document.querySelector('.hero video');
    if (!canvas || !fig || !video) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let seen = false;
    try {
      seen = sessionStorage.getItem('pix-assembled') === '1';
    } catch (e) {}
    if (reduce || seen) {
      canvas.style.display = 'none';
      return;
    }

    const ctx = canvas.getContext('2d');
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const DUR = 720; // per-particle travel
    const STAGGER = 440; // spread of start times
    let parts = [],
      W = 0,
      H = 0,
      GRID = 0,
      startT = 0,
      running = false;

    const img = new Image();
    img.decoding = 'async';
    img.src = video.getAttribute('poster');
    img.onload = prep;
    img.onerror = function () {
      canvas.style.display = 'none';
    };

    function prep() {
      const vb = video.getBoundingClientRect();
      const fb = fig.getBoundingClientRect();
      W = vb.width;
      H = vb.height;
      if (W < 4 || H < 4) {
        requestAnimationFrame(prep);
        return;
      } // await layout
      // sit exactly over the video
      canvas.style.top = vb.top - fb.top + 'px';
      canvas.style.left = vb.left - fb.left + 'px';
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.imageSmoothingEnabled = false;

      // sample the poster down to a coarse grid → ~5k chunky pixel blocks
      const TARGET = 5000;
      GRID = Math.max(6, Math.round(Math.sqrt((W * H) / TARGET)));
      const cols = Math.ceil(W / GRID),
        rows = Math.ceil(H / GRID);
      const off = document.createElement('canvas');
      off.width = cols;
      off.height = rows;
      const octx = off.getContext('2d');
      octx.drawImage(img, 0, 0, cols, rows);
      const d = octx.getImageData(0, 0, cols, rows).data;
      parts = [];
      for (let j = 0; j < rows; j++) {
        for (let i = 0; i < cols; i++) {
          const k = (j * cols + i) * 4;
          if (d[k + 3] < 8) continue;
          parts.push({
            tx: i * GRID,
            ty: j * GRID,
            // scatter start over a frame slightly larger than the canvas
            sx: -0.12 * W + Math.random() * 1.24 * W,
            sy: -0.12 * H + Math.random() * 1.24 * H,
            c: 'rgb(' + d[k] + ',' + d[k + 1] + ',' + d[k + 2] + ')',
            delay: Math.random() * STAGGER,
          });
        }
      }
      // pix:revealed may fire before the image decodes, so also self-start.
      document.addEventListener('pix:revealed', begin, { once: true });
      requestAnimationFrame(begin);
    }

    function begin() {
      if (running || !parts.length) return;
      running = true;
      startT = performance.now();
      requestAnimationFrame(frame);
    }

    function frame(now) {
      const el = now - startT;
      ctx.clearRect(0, 0, W, H);
      let done = true;
      const g = GRID + 1; // +1 hides seams between blocks
      for (let n = 0; n < parts.length; n++) {
        const p = parts[n];
        let t = (el - p.delay) / DUR;
        if (t < 0) {
          done = false;
          ctx.fillStyle = p.c;
          ctx.fillRect(p.sx | 0, p.sy | 0, g, g); // scattered, waiting
          continue;
        }
        if (t < 1) done = false;
        else t = 1;
        const e = 1 - Math.pow(1 - t, 3); // easeOutCubic
        ctx.fillStyle = p.c;
        ctx.fillRect((p.sx + (p.tx - p.sx) * e) | 0, (p.sy + (p.ty - p.sy) * e) | 0, g, g);
      }
      if (done) finish();
      else requestAnimationFrame(frame);
    }

    function finish() {
      ctx.clearRect(0, 0, W, H);
      ctx.drawImage(img, 0, 0, W, H); // crisp final frame
      try {
        sessionStorage.setItem('pix-assembled', '1');
      } catch (e) {}
      const pr = video.play();
      if (pr && pr.catch) pr.catch(function () {});
      canvas.style.transition = 'opacity 0.5s ease';
      requestAnimationFrame(function () {
        canvas.style.opacity = '0';
      });
      setTimeout(function () {
        canvas.style.display = 'none';
      }, 560);
    }
  })();
</script>
