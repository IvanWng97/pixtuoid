<script is:inline>
  // Scrolling is the light switch: every [data-lit] block pulls darkness in as it
  // approaches the viewport center and releases it in the observation gaps. One
  // style.opacity write per changed frame keeps it compositor-only.
  (function () {
    const dimmer = document.getElementById('dimmer');
    if (!dimmer) return;
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const DIM_MAX = 0.86;

    let blocks = []; // cached page-space rects; re-measured on resize/body-reflow
    let lastY = -1;
    let lastOp = -1;
    let raf = 0;
    let active = null; // the currently-faded [data-lit] block

    // smoothstep — darkness eases in/out with approach, no linear pop
    function ease(t) {
      return t * t * (3 - 2 * t);
    }

    // Every caller must run this SYNCHRONOUSLY, re-measure paths included. A
    // content reflow above the viewport moves window.scrollY in the same task, so
    // deferring the recompute to the next frame() tick paints one wrong frame —
    // anchor-adjusted y against stale blocks selects the wrong [data-lit] block.
    function recompute(y) {
      lastY = y;
      const center = y + window.innerHeight / 2;
      const reach = window.innerHeight * 0.55; // how far a block throws shade
      let best = 0;
      let bestEl = null;
      for (let i = 0; i < blocks.length; i++) {
        const b = blocks[i];
        const d = center < b.top ? b.top - center : center > b.bottom ? center - b.bottom : 0;
        const p = d >= reach ? 0 : 1 - d / reach;
        if (p > best) {
          best = p;
          bestEl = b.el;
        }
      }
      // A block may cap its own darkness below DIM_MAX via data-lit-max: the hero
      // holds a lower ceiling so the LIVE office actually reads above the fold.
      const cap = bestEl && bestEl.dataset.litMax ? parseFloat(bestEl.dataset.litMax) : DIM_MAX;
      const op = cap * ease(best);
      if (Math.abs(op - lastOp) > 0.002) {
        lastOp = op;
        dimmer.style.opacity = op.toFixed(3);
        // Polled global, deliberately NOT an event (contrast pix:onair): a
        // continuous per-frame value is read at the consumer's own cadence.
        window.__pixLights = op;
      }
      // Only the active block and the one it replaces are ever written.
      if (bestEl !== active) {
        if (active && active.getAttribute('data-lit') === 'fade') {
          active.style.opacity = '0.001';
        }
        active = bestEl;
      }
      if (active && active.getAttribute('data-lit') === 'fade') {
        const t = ease(best);
        active.style.opacity = (0.15 + 0.85 * t).toFixed(3);
        active.style.transform = 'translateY(' + Math.round(24 * (1 - t)) + 'px)';
      }
    }

    function measure() {
      const y = window.scrollY;
      blocks = Array.prototype.map.call(document.querySelectorAll('[data-lit]'), function (el) {
        const r = el.getBoundingClientRect();
        return { el, top: r.top + y, bottom: r.bottom + y };
      });
      recompute(y); // same task, before paint — see recompute()'s comment
    }

    function frame() {
      raf = 0;
      const y = window.scrollY;
      if (y !== lastY) recompute(y);
      raf = requestAnimationFrame(frame);
    }

    // Registered UNCONDITIONALLY, not behind the reduced-motion gate: a page
    // loaded reduced then un-reduced mid-session must not run the controller
    // forever on the single stale snapshot the un-reduce branch measured.
    let rraf = 0;
    window.addEventListener('resize', function () {
      if (rraf) return;
      rraf = requestAnimationFrame(function () {
        rraf = 0;
        measure();
      });
    });
    // content below (boot reveal, lazy media) can shift rects after load
    window.addEventListener('load', measure);
    // A Showcase channel tune swaps stages of different heights, which resize and
    // load alone miss. Call measure() DIRECTLY, with no rAF deferral: deferring by
    // a frame is exactly what lets the stale-block glitch reach the screen.
    if ('ResizeObserver' in window) {
      new ResizeObserver(measure).observe(document.body);
    }

    function wire() {
      if (mq.matches) return; // reduced motion: CSS holds the static level
      measure();
      raf = requestAnimationFrame(frame);
    }
    // DEFERRED: this is:inline script renders BEFORE <main>, so a parse-time
    // querySelectorAll sees zero [data-lit] blocks.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', wire, { once: true });
    } else {
      wire();
    }
    if (mq.addEventListener) {
      mq.addEventListener('change', function () {
        if (mq.matches && raf) {
          cancelAnimationFrame(raf);
          raf = 0;
          dimmer.style.opacity = ''; // CSS reduced-motion rule takes over
          // Reset EVERY faded block, not just `active`: one left at inline opacity
          // 0.001 (invisible h1/CTA) has no recovery while reduce stays on, and
          // the stranded block is often no longer the active one.
          document.querySelectorAll('[data-lit="fade"]').forEach(function (el) {
            el.style.opacity = '';
            el.style.transform = '';
          });
          active = null;
        } else if (!mq.matches && !raf) {
          measure();
          raf = requestAnimationFrame(frame);
        }
      });
    }
  })();
</script>
