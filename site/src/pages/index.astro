---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import OfficeBackdrop from '../components/OfficeBackdrop.astro';
import Hero from '../components/Hero.astro';
import Showcase from '../components/Showcase.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import SupportedTools from '../components/SupportedTools.astro';
import Install from '../components/Install.astro';
import Footer from '../components/Footer.astro';
import Statusline from '../components/Statusline.astro';
import { asset, REPO, CRATES } from '../consts';
import installTabs from '../install.json';

// The closer's install line — same single source as the hero row and the
// splash (install.json's brew entry).
const brew = installTabs.find((t) => t.id === 'brew');
if (!brew) throw new Error('index: install.json lost its brew entry');
const BREW_CMD = brew.cmds[0];

// Homepage structured data: a free cross-platform developer tool. Search
// engines use this for a rich result; the version is single-sourced from the
// workspace Cargo.toml at build (same define as everywhere else).
const SITE = Astro.site ?? new URL('https://ivanwng97.github.io');
const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'pixtuoid',
  description:
    'A terminal-native pixel-art office that visualizes your AI coding agents (Claude Code, Codex, and more) as animated coworkers.',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  url: new URL(asset(''), SITE).href,
  downloadUrl: CRATES,
  softwareVersion: __PIXTUOID_VERSION__,
  license: 'https://opensource.org/licenses/MIT',
  codeRepository: REPO,
  author: { '@type': 'Person', name: 'Ivan Wang', url: REPO },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Base preloadImage={asset('demos/hero-wide.png')} jsonLd={softwareJsonLd}>
  <span id="top"></span>
  <OfficeBackdrop />
  <Nav floating />
  <main id="main" tabindex="-1">
    <Hero />
    {/* observation gap 1 — the dim releases to 0; the office IS the content */}
    <div class="office-gap">
      <p class="gap-caption" aria-hidden="true">
        — you're watching the real thing: the same engine that runs in your terminal.
      </p>
    </div>
    <Showcase />
    <Features />
    {
      /* observation gap 2 — with the frameless-window beat: the real floating
        window is an OPAQUE, chrome-less rect of office pixels (softbuffer
        writes XRGB, no alpha), so the beat is an office still at window
        scale floating over the page office — the pixel-scale contrast is
        what reads as "a separate window". */
    }
    <div class="office-gap">
      <div class="gap-frame" aria-hidden="true">
        <img
          class="gap-frame__body px"
          src={asset('demos/night.png')}
          data-gap-still
          data-day={asset('demos/day.png')}
          data-night={asset('demos/night.png')}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
      <p class="gap-caption" aria-hidden="true">
        — the floating desktop window: the same office, popped out of the terminal. lighting follows
        your clock; it's <span data-gap-daynight>night</span> where you are.
      </p>
    </div>
    <HowItWorks />
    <SupportedTools />
    <Install />
    {
      /* observation gap 3 — the closing hold: the page's LAST install line.
        The caption is NOT aria-hidden anymore: it carries a real control now
        (spec §4 — the emotional peak is no longer a dead end). */
    }
    <div class="office-gap">
      <div class="gap-caption gap-caption--closer">
        <p class="closer-line">— your office is waiting.</p>
        <div class="closer-install" data-install-row>
          <code>$ <span data-cmd>{BREW_CMD}</span></code>
          <button class="closer-install__copy" data-install-copy data-source="closer"
            >[ copy ]</button
          >
          <span class="sr-only" role="status" data-copy-status></span>
        </div>
      </div>
    </div>
  </main>
  <script is:inline>
    // gap 2 follows the viewer's clock: the word AND the window still swap
    // together off __pixNight (the one boundary, defined in Base's head boot).
    (function () {
      const night = window.__pixNight();
      const el = document.querySelector('[data-gap-daynight]');
      if (el) el.textContent = night ? 'night' : 'day';
      const img = document.querySelector('[data-gap-still]');
      if (img) img.src = night ? img.dataset.night : img.dataset.day;
    })();
  </script>
  <script is:inline>
    // The closer's copy chip: routes through window.__pixInstall.copy(source) —
    // THE one-liner's single clipboard-write + pix:install-copy dispatch
    // (Base.astro head boot; also ridden by the statusline chip) — so this
    // chip can't grow a second copy of that logic. copy() only dispatches on
    // a successful write; the manual-select fallback below (no/blocked
    // Clipboard API) fires the event itself, since the visitor's install
    // intent is the same either way.
    (function () {
      const btn = document.querySelector('.closer-install [data-install-copy]');
      if (!btn) return;
      const row = btn.closest('[data-install-row]');
      const status = row && row.querySelector('[data-copy-status]');
      const source = btn.dataset.source;
      // constant resting label — capturing textContent after a click would
      // capture the flash and stick (the Install.astro-documented trap)
      const LABEL = '[ copy ]';
      function flash(label, announce) {
        btn.textContent = label;
        if (status) status.textContent = announce;
        clearTimeout(btn.__pixRestore);
        btn.__pixRestore = setTimeout(function () {
          btn.textContent = LABEL;
          if (status) status.textContent = '';
        }, 1600);
      }
      function manual() {
        // select JUST the command span, not the whole <code> — the '$ ' prompt
        // prefix lives outside it, so a paste of the selection can't include it.
        const cmd = row && row.querySelector('[data-cmd]');
        const sel = window.getSelection && window.getSelection();
        if (cmd && sel) {
          const range = document.createRange();
          range.selectNodeContents(cmd);
          sel.removeAllRanges();
          sel.addRange(range);
        }
        flash('[ select & copy ]', 'Press Ctrl+C to copy the selected command');
        document.dispatchEvent(new CustomEvent('pix:install-copy', { detail: { source: source } }));
      }
      btn.addEventListener('click', function () {
        if (!window.__pixInstall) {
          manual();
          return;
        }
        window.__pixInstall.copy(source).then(function (ok) {
          if (ok) flash('[ copied ✓ ]', 'Copied to clipboard');
          else manual();
        });
      });
    })();
  </script>
  <Footer />
  <Statusline />
</Base>
